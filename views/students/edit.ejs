<!DOCTYPE html>
<html>
<head>

<title>Edit Student</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

</head>

<body class="container mt-5">

<%- include('../partials/flash') %>

<h1 class="mb-4">Edit Student</h1>

<form method="POST" action="/edit/<%= student.id %>" enctype="multipart/form-data">

    <input
        type="text"
        name="name"
        value="<%= student.name %>"
        class="form-control mb-3"
        required>

    <input
        type="text"
        name="course"
        value="<%= student.course %>"
        class="form-control mb-3"
        required>

    <input
        type="number"
        name="age"
        value="<%= student.age %>"
        class="form-control mb-3"
        required>

    <!-- CURRENT IMAGE -->
    <% if (student.image) { %>
        <div class="mb-3">
            <p>Current Image:</p>
            <img src="/uploads/<%= student.image %>" width="100">
        </div>
    <% } %>

    <!-- NEW IMAGE UPLOAD -->
    <input type="file" name="image" class="form-control mb-3">

    <button class="btn btn-primary">
        Update
    </button>

</form>

</body>
</html>